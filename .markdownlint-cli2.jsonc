{
  // Lenient config for authoring Grok Bot recipe Markdown.
  // Focuses on catching real structural mistakes, not stylistic line width.
  "config": {
    "default": true,
    "MD013": false, // line length: recipes can contain long lines
    "MD033": false, // allow inline HTML
    "MD041": false, // first line need not be a top-level heading
    "MD024": { "siblings_only": true } // allow repeated headings in different sections
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules"]
}
